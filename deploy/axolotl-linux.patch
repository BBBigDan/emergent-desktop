diff --git a/prototype-rust/Cargo.toml b/prototype-rust/Cargo.toml
index 0e5a62f..b2958a7 100644
--- a/prototype-rust/Cargo.toml
+++ b/prototype-rust/Cargo.toml
@@ -35,16 +35,17 @@ num-traits = "0.2"
 # 随机数（用于近似算法）
 rand = "0.8"
 
+# 内存映射（用于大于内存的图）—— 跨平台，不要放进 macOS 块
+memmap2 = "0.9"
+
+# Python 绑定
+pyo3 = { version = "0.23", features = ["extension-module"], optional = true }
+
 # GPU 支持（Metal on macOS）
 [target.'cfg(target_os = "macos")'.dependencies]
 metal = "0.29"
 dispatch = "0.2"
 
-# 内存映射（用于大于内存的图）
-memmap2 = "0.9"
-
-# Python 绑定
-pyo3 = { version = "0.23", features = ["extension-module"], optional = true }
 
 [features]
 default = []
@@ -60,6 +61,7 @@ proptest = "1.4"
 # 随机图生成（用于基准测试）
 rand = "0.8"
 
+
 [[bench]]
 name = "graph_benchmark"
 harness = false
