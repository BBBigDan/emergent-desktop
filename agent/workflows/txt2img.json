{
  "label": "文生图 · 方图 512",
  "doc": "最便宜的一档。少步蒸馏模型（LCM / Turbo）4~8 步就够；这台是纯 CPU，一张 20~60 秒。",
  "note": "提示词写画面本身：主体 + 环境 + 光线 + 画风。别写「请帮我画」。",
  "size": [512, 512],
  "steps": 6,
  "sampler": "lcm",
  "scheduler": "normal",
  "cfg": 1.5,
  "model": "dreamshaper8_lcm.safetensors",
  "workflow": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "__MODEL__" }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": { "width": "__W__", "height": "__H__", "batch_size": 1 }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "__PROMPT__", "clip": ["4", 1] }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "__NEGATIVE__", "clip": ["4", 1] }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "seed": "__SEED__",
        "steps": "__STEPS__",
        "cfg": "__CFG__",
        "sampler_name": "__SAMPLER__",
        "scheduler": "__SCHEDULER__",
        "denoise": 1.0,
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": { "filename_prefix": "__PREFIX__", "images": ["8", 0] }
    }
  }
}
