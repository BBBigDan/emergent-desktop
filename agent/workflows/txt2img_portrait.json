{
  "label": "文生图 · 竖图 512×768",
  "doc": "竖版（人物、海报、手机壁纸）。同样的步数比方图慢约 1.5 倍。",
  "note": "竖图更容易出全身人物；不要把方图的提示词直接搬过来，构图要重写。",
  "size": [512, 768],
  "steps": 6,
  "sampler": "lcm",
  "scheduler": "normal",
  "cfg": 1.5,
  "model": "dreamshaper8_lcm.safetensors",
  "workflow": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "__MODEL__" }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": { "width": "__W__", "height": "__H__", "batch_size": 1 }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "__PROMPT__", "clip": ["4", 1] }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "__NEGATIVE__", "clip": ["4", 1] }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "seed": "__SEED__",
        "steps": "__STEPS__",
        "cfg": "__CFG__",
        "sampler_name": "__SAMPLER__",
        "scheduler": "__SCHEDULER__",
        "denoise": 1.0,
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": { "filename_prefix": "__PREFIX__", "images": ["8", 0] }
    }
  }
}
