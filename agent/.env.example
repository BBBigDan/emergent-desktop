# 复制成 .env 再填。.env 不进仓库。
#
# 模型：任何 OpenAI 兼容接口都能用，改 MODEL_BASE 即可。
# 硅基流动的免费模型里，带工具调用的推荐：
#   deepseek-ai/DeepSeek-V4-Flash   ~1.1s/步，会并行发工具调用
#   Qwen/Qwen2.5-7B-Instruct       ~0.9s/步，最稳但不会并行
#   zai-org/GLM-5.3-Flash          ~3s/步
# 换成 mock 就不联网：MODEL=mock
MODEL_KEY=
MODEL=deepseek-ai/DeepSeek-V4-Flash
MODEL_BASE=https://api.siliconflow.cn/v1

# 数据源：host 读本机真实数字，mock 给固定假数据（调提示词时可复现）
SYS=host

# 可选
# MODEL_TEMP=0.3
# MODEL_MAX_TOKENS=900
# MODEL_TIMEOUT=45000
# MAX_STEPS=8
