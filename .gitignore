# ---- 依赖 ----
node_modules/
package-lock.json
pnpm-lock.yaml.bak

# ---- 构建产物（由 prototype/build-standalone.mjs 生成，可随时重建）----
particle-sphere-standalone.html

# ---- 验证产物：截图 / 临时探针页面 / CDP 驱动 ----
dist/
.tmp/
*.log

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 本地调试产物
.tmp/

# ---- 凭据 ----
# agent/.env 里有模型的 API key，只能留在本机
agent/.env
.env

# kubeconfig 里有集群的客户端私钥（client-key-data）。
# 它等价于 root 在这台机器上的 shell —— 推上去等于把机器交出去。
agent/.kube/
*.kubeconfig

# ---- 会话存档（本地跑出来的对话与最后一屏）----
agent/sessions/

# ---- token 日账本（本地跑出来的用量，一天一个文件）----
agent/usage/

# ---- 长期记忆（本地跑出来的库与快照）----
agent/memory/
agent/.tools/
